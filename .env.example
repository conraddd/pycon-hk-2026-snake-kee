# Copy to .env and fill in.  (.env is git-ignored)

# Your Lakebase project id (Databricks workspace -> Lakebase -> your project)
LAKEBASE_PROJECT=<your-project-id>

# Databricks CLI profile to use (the --profile you gave `databricks auth login`).
# Leave commented out to use your DEFAULT profile.
# DATABRICKS_CONFIG_PROFILE=snake-kee

# Branch that new branches are created from, and how long they live
LAKEBASE_SOURCE_BRANCH=production
LAKEBASE_BRANCH_TTL_HOURS=24

# Compute for new branches: autoscale between these Compute Units, scale to zero when idle
LAKEBASE_MIN_CU=0.5
LAKEBASE_MAX_CU=2
LAKEBASE_SUSPEND_MINUTES=5

# Force a branch instead of following git (e.g. for migrating/seeding production):
# LAKEBASE_BRANCH=production

# Django: debug mode for local development
DJANGO_DEBUG=1
